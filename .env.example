# =============================================================================
# OFA AI Assist — Finance Knowledge Assistant
# Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Azure OpenAI
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o          # GPT-4o deployment name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072       # 1536 for text-embedding-ada-002

# -----------------------------------------------------------------------------
# Azure AI Search
# -----------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-admin-key>
AZURE_SEARCH_INDEX_NAME=ofa-finance-kb
AZURE_SEARCH_SEMANTIC_CONFIG=ofa-finance-semantic-config

# -----------------------------------------------------------------------------
# SharePoint
# -----------------------------------------------------------------------------
SHAREPOINT_TENANT_ID=<your-tenant-id>
SHAREPOINT_CLIENT_ID=<your-app-registration-client-id>
SHAREPOINT_CLIENT_SECRET=<your-app-registration-client-secret>
SHAREPOINT_SITE_URL=https://<tenant>.sharepoint.com/sites/<site-name>
SHAREPOINT_FOLDER_PATH=/Shared Documents/Knowledge Base

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
APP_HOST=0.0.0.0
APP_PORT=8000

# -----------------------------------------------------------------------------
# RAG Tuning
# -----------------------------------------------------------------------------
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5                  # Number of chunks retrieved per query
RAG_SCORE_THRESHOLD=0.75     # Minimum relevance score to include a chunk

# -----------------------------------------------------------------------------
# Streamlit
# -----------------------------------------------------------------------------
STREAMLIT_BACKEND_URL=http://localhost:8000
STREAMLIT_PAGE_TITLE=OFA AI Assist — Finance Assistant
